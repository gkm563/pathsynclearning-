# Tutor / copilot / notes (Groq). Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Ollama Cloud — two keys so interview and roadmap can run at the same time
# (Cloud often allows one concurrent request per key).
# https://ollama.com/settings/keys
OLLAMA_INTERVIEW_API_KEY=
OLLAMA_ROADMAP_API_KEY=
# Optional shared fallback if a purpose-specific key is empty
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_INTERVIEW_MODEL=gpt-oss:120b
OLLAMA_ROADMAP_MODEL=gpt-oss:120b

# Optional — used for sitemap / Open Graph absolute URLs only (not Clerk auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (from Dashboard or `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Relative paths — Clerk resolves against the current app origin (not accounts.dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Proctoring for assessments and interviews (fullscreen, clipboard, 3-strike fail).
NEXT_PUBLIC_ASSESSMENT_PROCTORING=true

# Optional — NewsAPI.org key for extra tech headlines. Dev.to is the primary free source (no key).
# Never prefix with NEXT_PUBLIC_ — kept server-side only.
NEWS_API_KEY=
# Optional — minutes before refreshing the news cache (default 30).
NEWS_CACHE_TTL_MINUTES=30

# LiveKit — Cloud now; in production point this at your self-hosted VPS.
# Dev:  wss://<project>.livekit.cloud
# Prod: wss://livekit.your-domain.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=pathed-interviewer
# Shared secret for the local Python interviewer worker (any long random string).
INTERVIEW_AGENT_SECRET=

# Code execution (Python / Java / C / C++). JavaScript grades in-process (Node vm) and does not need this.
# Public https://ce.judge0.com is often locked. Use RapidAPI or a self-hosted Judge0.
# JUDGE0_API_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
# JUDGE0_RAPIDAPI_KEY=
# JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Optional — YouTube Data API for lesson search. Server-side only.
YOUTUBE_API_KEY=
# Reuse search rows this many days (default 30). Empty searches expire in 24h.
YOUTUBE_CACHE_TTL_DAYS=30
