# Server-only Gemini key used by /api/ai/* routes. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional — used for sitemap / Open Graph absolute URLs only (not Clerk auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (from Dashboard or `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Relative paths — Clerk resolves against the current app origin (not accounts.dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue

# Neon PostgreSQL (server-only). Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
