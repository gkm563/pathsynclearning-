# Server-only Groq key for roadmap generation (model: openai/gpt-oss-120b). Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Server-only Gemini key used as fallback and for /api/ai/* routes. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional — used for sitemap / Open Graph absolute URLs only (not Clerk auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (from Dashboard or `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Relative paths — Clerk resolves against the current app origin (not accounts.dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional — used for assessment proctoring only.
NEXT_PUBLIC_ASSESSMENT_PROCTORING=false

# Optional — NewsAPI.org key for extra tech headlines. Dev.to is the primary free source (no key).
# Never prefix with NEXT_PUBLIC_ — kept server-side only.
NEWS_API_KEY=
# Optional — minutes before refreshing the news cache (default 30).
NEWS_CACHE_TTL_MINUTES=30

# LiveKit — Cloud now; in production point this at your self-hosted VPS.
# Dev:  wss://<project>.livekit.cloud
# Prod: wss://livekit.your-domain.com
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=pathed-interviewer
# Shared secret for the local Python interviewer worker (any long random string).
INTERVIEW_AGENT_SECRET=

# Ollama Cloud — AI interview LLM only. Other PathED AI features keep using GROQ_API_KEY.
# Key from https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_INTERVIEW_MODEL=gpt-oss:120b
