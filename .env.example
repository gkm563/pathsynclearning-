# Server-only Gemini key used by /api/ai/* routes. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Clerk (from Dashboard or `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# Neon PostgreSQL (server-only). Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
