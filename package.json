{
  "name": "pathed",
  "private": true,
  "version": "1.0.0",
  "description": "PathEd — career readiness platform for engineering students",
  "scripts": {
    "clean": "node scripts/clean-next.mjs",
    "dev": "next dev",
    "dev:fresh": "node scripts/clean-next.mjs --dev && next dev",
    "prebuild": "node scripts/clean-next.mjs --prod",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:portal-shell": "node scripts/check-portal-shell.mjs",
    "typecheck": "tsc --noEmit",
    "db:setup": "npx tsx scripts/sync-db.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "db:migrate:memory-lane": "npx tsx scripts/migrate-memory-lane.ts",
    "db:migrate:tech-news": "npx tsx scripts/migrate-tech-news.ts",
    "db:migrate:profile": "npx tsx scripts/migrate-profile-management.ts",
    "db:migrate:roadmap-company": "npx tsx scripts/migrate-roadmap-target-company.ts",
    "db:migrate:notifications": "npx tsx scripts/migrate-notifications.ts",
    "db:migrate:student-id": "npx tsx scripts/migrate-student-registration-id.ts",
    "db:migrate:problems": "npx tsx scripts/migrate-problems-catalog.ts",
    "db:migrate:wallet-coins": "npx tsx scripts/migrate-wallet-starting-coins.ts",
    "db:migrate:copilot": "npx tsx scripts/migrate-copilot-chat.ts",
    "db:migrate:copilot-companion": "npx tsx scripts/migrate-copilot-companion.ts",
    "db:migrate:interview": "npx tsx scripts/migrate-interview.ts",
    "db:migrate:roadmap-certification": "npx tsx scripts/migrate-roadmap-certification.ts",
    "interview:agent": "node scripts/run-interview-agent.mjs",
    "db:seed:problems": "npx tsx scripts/seed-problems.ts",
    "db:sync": "npx tsx scripts/sync-db.ts",
    "test:progress": "npx tsx scripts/test-progress-calc.ts",
    "test:news": "npx tsx scripts/test-news-normalize.ts",
    "test:video-recommend": "npx tsx scripts/test-video-recommend.ts",
    "test:student-id": "npx tsx scripts/test-student-registration-id.ts",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.6",
    "@dagrejs/dagre": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@xyflow/react": "^12.11.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "groq-sdk": "^1.5.0",
    "lightningcss": "^1.33.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "lucide-react": "^1.25.0",
    "next": "^15.5.12",
    "prettier": "^3.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.12",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "lightningcss": "$lightningcss"
  }
}
